%# Shared by resume.tex.j2 and letter.tex.j2. Only \VAR{opt...} values reach here.
\documentclass[letterpaper,\VAR{opt.font_size}pt]{article}

\usepackage{iftex}
\ifPDFTeX
  \usepackage[T1]{fontenc}
  \usepackage[utf8]{inputenc}
\else
  \usepackage[T1]{fontenc}
\fi
\usepackage[scaled]{helvet}
\renewcommand{\familydefault}{\sfdefault}
\usepackage[letterpaper,top=0.6in,bottom=0.6in,left=\VAR{opt.margin}in,right=\VAR{opt.margin}in]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{xcolor}
\usepackage[hidelinks,bookmarks=false]{hyperref}
\usepackage{tabularx}

\definecolor{accent}{HTML}{\VAR{opt.accent}}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\linespread{1.06}
\setlength{\tabcolsep}{0pt}
\hyphenpenalty=10000
\exhyphenpenalty=10000

\titleformat{\section}{\color{accent}\large\bfseries}{}{0em}{\MakeUppercase}[{\color{accent}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{10pt}{5pt}

\setlist[itemize]{leftmargin=1.1em,itemsep=2pt,parsep=0pt,topsep=2.5pt,label=\textbullet}

% \entry{Title}{Dates}{Subtitle}{Location}
\newcommand{\entry}[4]{%
  \begin{tabularx}{\linewidth}{@{}X r@{}}
    \textbf{#1} & \textbf{#2}\\
    \textit{#3} & \textit{\small #4}
  \end{tabularx}\vspace{-1pt}}
% \entryshort{Title}{Dates}
\newcommand{\entryshort}[2]{%
  \begin{tabularx}{\linewidth}{@{}X r@{}}
    \textbf{#1} & \textbf{#2}
  \end{tabularx}\vspace{-1pt}}
% \project{Title}{Stack}{Dates}
\newcommand{\project}[3]{%
  \begin{tabularx}{\linewidth}{@{}X r@{}}
    \textbf{#1}\;{\small\textcolor{gray}{$\vert$}\;\textit{#2}} & \textbf{#3}
  \end{tabularx}\vspace{-1pt}}
% \projectshort{Title}{Dates}
\newcommand{\projectshort}[2]{\entryshort{#1}{#2}}

\newcommand{\contactsep}{\;$\cdot$\;}
